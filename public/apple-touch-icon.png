<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" width="100%" height="100%">
  <defs>
    <clipPath id="squircle-clip">
      <rect x="16" y="16" width="480" height="480" rx="110" ry="110" />
    </clipPath>
  </defs>
  
  <!-- Icon Background Box -->
  <rect x="16" y="16" width="480" height="480" rx="110" ry="110" fill="#7ab81e" stroke="#000000" stroke-width="16" />
  
  <g stroke="#000000" stroke-linecap="round" stroke-linejoin="round">
    <!-- Chimney -->
    <path d="M350 130 V200 H385 V130 Z" fill="#7ab81e" stroke-width="22" />

    <!-- House Roof -->
    <path d="M105 245 L256 95 L407 245" fill="none" stroke-width="26" />

    <!-- House Walls & Floor -->
    <path d="M135 270 V405 H377 V270" fill="none" stroke-width="26" />

    <!-- Dumbbell Top Weight Stack -->
    <!-- Top Cap -->
    <rect x="238" y="180" width="36" height="16" rx="6" fill="#7ab81e" stroke-width="16" />
    <!-- Top Big Plate -->
    <rect x="200" y="196" width="112" height="34" rx="10" fill="#7ab81e" stroke-width="18" />

    <!-- Dumbbell Center Bar / Shaft -->
    <rect x="236" y="230" width="40" height="85" rx="8" fill="#7ab81e" stroke-width="18" />

    <!-- Dumbbell Bottom Weight Stack -->
    <!-- Bottom Big Plate -->
    <rect x="200" y="315" width="112" height="34" rx="10" fill="#7ab81e" stroke-width="18" />
    <!-- Bottom Cap -->
    <rect x="216" y="349" width="80" height="18" rx="6" fill="#7ab81e" stroke-width="16" />
  </g>
</svg>
